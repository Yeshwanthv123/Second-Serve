# No .env file is needed for the default real local LLM.
AGENT_MODE=ollama
OLLAMA_MODEL=qwen3:4b-instruct
AGENT_TIMEOUT_SECONDS=600
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
# Set AGENT_MODE=bedrock and supply credentials with bedrock:InvokeModel and
# bedrock:InvokeModelWithResponseStream permission for an accessible model.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Keep false for localhost HTTP. Use true behind HTTPS on a hosted deployment.
COOKIE_SECURE=false
APP_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
# No key required for non-commercial city search. Map tiles need internet.
GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
